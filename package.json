{
	"name": "streamdeck-rme-totalmix",
	"version": "1.1.3",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"bundle": "rollup -c rollup.config.mjs",
		"test": "npm run build && node --test test/*.test.mjs",
		"watch": "rollup -c rollup.config.mjs -w --watch.onEnd=\"streamdeck restart com.haeunga0822.rme-totalmix\"",
		"pack": "npm run bundle && streamdeck pack com.haeunga0822.rme-totalmix.sdPlugin"
	},
	"dependencies": {
		"@elgato/streamdeck": "3.0.4"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.4",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.1",
		"@types/node": "^26.6.6",
		"rollup": "^4.66.0",
		"tslib": "^2.8.1",
		"typescript": "~6.0.3"
	}
}
