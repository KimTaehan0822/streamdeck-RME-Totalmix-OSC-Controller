			"Controllers": [
				"Encoder"
			],
			"PropertyInspectorPath": "ui/vu-dial.html",
			"Encoder": {
				"layout": "layouts/strip.json",
				"TriggerDescription": {
					"Rotate": "Fader +/- 1 dB",
					"Push": "Mute",
