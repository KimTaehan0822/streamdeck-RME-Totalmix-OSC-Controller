{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"SDKVersion": 2,
	"UUID": "com.haeunga0822.rme-totalmix",
	"Name": "OSC Controller for RME TotalMix",
	"Version": "1.0.2.0",
	"Author": "김탄2",
	"Icon": "imgs/plugin",
	"Category": "OSC Controller for RME TotalMix",
	"Description": "Control RME TotalMix FX over Global OSC.",
	"CodePath": "bin/plugin.js",
	"Nodejs": {
		"Version": "20"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Software": {
		"MinimumVersion": "7.3"
	},
	"Actions": [
		{
			"Name": "Mute",
			"UUID": "com.haeunga0822.rme-totalmix.mute",
			"Icon": "imgs/channel",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/channel-toggle.html",
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/channel"
				},
				{
					"Image": "imgs/channel"
				}
			]
		},
		{
			"Name": "Solo",
			"UUID": "com.haeunga0822.rme-totalmix.solo",
			"Icon": "imgs/channel",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/channel-toggle.html",
			"States": [
				{
					"Image": "imgs/channel"
				}
			]
		},
		{
			"Name": "Input option (48V, Inst, Pad, AutoSet)",
			"UUID": "com.haeunga0822.rme-totalmix.input-option",
			"Icon": "imgs/channel",
			"Controllers": [
				"Keypad"
			],
