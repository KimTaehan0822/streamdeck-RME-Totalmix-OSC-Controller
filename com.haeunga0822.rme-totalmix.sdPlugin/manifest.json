			"States": [
				{
					"Image": "imgs/channel"
				}
			]
		},
		{
			"Name": "Group",
			"UUID": "com.haeunga0822.rme-totalmix.group",
			"Icon": "imgs/channel",
			"Controllers": [
				"Keypad"
			],
